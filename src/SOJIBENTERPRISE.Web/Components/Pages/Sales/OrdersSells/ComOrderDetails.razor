<style>
    .rz-datatable-footer {
        font-weight: bold;
        text-align: right;
        background-color: #f8f9fa;
        border-top: 1px solid #dee2e6;
    }

</style>
<Message @ref="notificationComponent" />

    <div class="card-body m-0">
        <h4>Order #@OrderId</h4>
        <h4>Total Due: ৳@TotalDue.ToString("0.00")</h4>

        <div class="d-flex align-items-center mb-3" style="width: 100%;">
            <RadzenButton Text="Back" ButtonStyle="ButtonStyle.Secondary" Click="Cancel" Class="m-2" />

            <!-- Export Button -->
            @* <div class="d-flex align-items-center border rounded" style="width: fit-content;">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem;" Wrap="FlexWrap.Wrap" Style="padding-left: 0.10rem;">
                    <RadzenButton Text="Export To PDF" Icon="picture_as_pdf" Click="@(args => ExportToPdf())" />
                </RadzenStack>
            </div> *@
        </div>


        <div class="summary-container">
            <div class="d-flex justify-content-between border-bottom py-1">
                <div class="fw-bold">Total Cash Paid:</div>
                <div class="fw-bold">৳@OrderPaymentHistoryByOrderList.Sum(x => x.AmountPaid).ToString("N2")</div>
            </div>

            @foreach (var shop in DSRShopDueList)
            {
                <div class="d-flex justify-content-between border-bottom py-1">
                    <div>@shop.DueHistory:</div>
                    <div>৳@shop.DueAmount.ToString("N2")</div>
                </div>
            }

            <div class="d-flex justify-content-between border-bottom py-1">
                <div class="fw-bold">Total Shop Amount:</div>
                <div class="fw-bold">৳@DSRShopDueList.Sum(x => x.DueAmount).ToString("N2")</div>
            </div>

            @foreach (var expense in DailyExpenseList)
            {
                <div class="d-flex justify-content-between border-bottom py-1">
                    <div>@expense.DailyExpenseType.Name Amount:</div>
                    <div>৳@expense.Amount.ToString("N2")</div>
                </div>
            }

            <div class="d-flex justify-content-between border-bottom py-1">
                <div class="fw-bold">Total Expense Amount:</div>
                <div class="fw-bold">৳@DailyExpenseList.Sum(x => x.Amount).ToString("N2")</div>
            </div>

            <div class="d-flex justify-content-between py-1">
                <div class="fw-bold">Grand Total Amount:</div>
                <div class="fw-bold">৳@GrandTotal.ToString("N2")</div>
            </div>
        </div>

    </div>


